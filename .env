# 阿里云百炼 API Key（Qwen3-TTS 语音合成）
DASHSCOPE_API_KEY=sk-3c7f51410f1b437a97c4552095e6e9ba

# TTS 音色：沧明子（低沉苍老智慧老者）
TTS_VOICE=Eldric Sage
TTS_MODEL=qwen3-tts-flash

# 模板视频1
VIDEO_TEMPLATE_PATH_1=./模板视频1.mp4
TRAJECTORY_JSON_PATH_1=./trajectory.json

# 模板视频2（轨迹坐标文件后续补上）
VIDEO_TEMPLATE_PATH_2=./模板视频2.mp4
TRAJECTORY_JSON_PATH_2=./trajectory2.json

# 纸面字体文件路径：使用马善政毛笔手写字体，随仓库携带并附带 OFL 许可证
PAPER_FONT_PATH=./public/fonts/MaShanZheng-Regular.ttf
# 兼容旧配置名；未设置 PAPER_FONT_PATH 时才会回落使用
XINGSHU_FONT_PATH=./public/fonts/Xingkai.ttf

# 纸面文字质感：高速晃动时匹配纸面运动模糊，减少清晰贴片悬浮感
TEXT_MOTION_BLUR_SCALE=0.6
TEXT_MOTION_BLUR_MAX_KERNEL=5
TEXT_BASE_DARKEN=0.94
TEXT_EDGE_SOFTEN_SIGMA=0.60
TEXT_PAPER_TEXTURE_GAIN=0.40
TEXT_HALO_WEIGHT=0.07
TEXT_INK_GRAIN_GAIN=0.10
TEXT_INK_SINK_STRENGTH=0.20
TEXT_LAYOUT_CONTENT_SCALE=1.0
TEXT_LAYOUT_Y_OFFSET_RATIO=0.080

# AE 坐标源尺寸
TRAJECTORY_SOURCE_WIDTH=720
TRAJECTORY_SOURCE_HEIGHT=1280
