# =========================
# 祈愿视频生成系统 - 环境变量配置
# 复制此文件为 .env，填入真实值
# =========================

# 阿里云百炼 API Key（Qwen3-TTS 语音合成）
# 获取地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-你的APIKey

# TTS 音色（默认沧明子 Eldric Sage，低沉苍老智慧老者，适合庙宇祈福）
TTS_VOICE=Eldric Sage
TTS_MODEL=qwen3-tts-flash

# 模板视频路径
VIDEO_TEMPLATE_PATH=./模板视频1.mp4

# 轨迹坐标文件路径
TRAJECTORY_JSON_PATH=./trajectory.json

# 行书字体文件路径
XINGSHU_FONT_PATH=./public/fonts/Xingkai.ttf

# 纸面文字质感：高速运动模糊、飞白和纸纹融合
TEXT_MOTION_BLUR_SCALE=0.7
TEXT_MOTION_BLUR_MAX_KERNEL=35
TEXT_MOTION_BLUR_GAUSSIAN_SCALE=0.12
TEXT_FAST_MOTION_THRESHOLD=18.0
TEXT_FAST_OPACITY_MIN=0.72
TEXT_BASE_DARKEN=0.94
TEXT_EDGE_SOFTEN_SIGMA=0.60
TEXT_PAPER_TEXTURE_GAIN=0.60
TEXT_HALO_WEIGHT=0.07
TEXT_INK_GRAIN_GAIN=0.30
TEXT_INK_SINK_STRENGTH=0.20
TEXT_LAYOUT_CONTENT_SCALE=1.0
TEXT_LAYOUT_Y_OFFSET_RATIO=0.0
TEXT_LAYER_ROTATION_GAIN=1.0
TEXT_LAYER_ROTATION_MAX_DEGREES=4.0

# AE 坐标源尺寸（一般不需要改）
TRAJECTORY_SOURCE_WIDTH=720
TRAJECTORY_SOURCE_HEIGHT=1280
