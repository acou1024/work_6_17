# =========================
# 祈愿视频生成系统 - 环境变量配置
# 复制此文件为 .env，填入真实值
# =========================

# 阿里云百炼 API Key（Qwen3-TTS 语音合成）
# 获取地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-你的APIKey

# TTS 音色（默认沧明子 Eldric Sage，低沉苍老智慧老者，适合庙宇祈福）
TTS_VOICE=Eldric Sage
TTS_MODEL=qwen3-tts-flash

# 模板视频路径
VIDEO_TEMPLATE_PATH=./模板视频1.mp4

# 轨迹坐标文件路径
TRAJECTORY_JSON_PATH=./trajectory.json

# 行书字体文件路径
XINGSHU_FONT_PATH=./public/fonts/Xingkai.ttf

# AE 坐标源尺寸（一般不需要改）
TRAJECTORY_SOURCE_WIDTH=720
TRAJECTORY_SOURCE_HEIGHT=1280
